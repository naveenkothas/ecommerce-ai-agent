# Server
PORT=3000

# Store API base URL (used by the agent to call backend endpoints)
STORE_API_BASE_URL=http://localhost:3000

# Ollama configuration
# Make sure Ollama is running: https://ollama.com
# Pull the model: ollama pull qwen3:8b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Agent settings
AGENT_MAX_MESSAGE_LENGTH=2000
AGENT_MAX_STEPS=10
